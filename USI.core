CAPI=2:
name: socet:aft:USI:0.1.0

filesets:
    rtl_register_map:
        depend:
            - "socet:bus-components:bus_protocol_if:0.0.1"
        files:
            - source/register_map.sv
        file_type: systemVerilogSource
    
    rtl_split_fifo:
        files:
            - source/split_fifo.sv
        file_type: systemVerilogSource

    rtl_usi_datapath:
        files:
            - source/usi_datapath.sv
            - source/split_fifo.sv
            - source/shift_register.sv
        file_type: systemVerilogSource

    tb_usi_datapath:
        files:
            - testbench/usi_datapath_tb.sv
        file_type: systemVerilogSource

    rtl_I2C:
        files:
            - source/Kade/flexCounter.sv
            - source/Kade/I2C.sv
        file_type: systemVerilogSource

    tb_I2C:
        files:
            - testbench/I2C_tb.sv
        file_type: systemVerilogSource

    tb_bus_interface_shim:
        files:
            - testbench/support/bus_protocol_if.sv
        file_type: systemVerilogSource

    rtl_usi_uart:
        files:
            - source/register_map.sv
            - source/control_unit.sv
            - source/uart.sv
            - source/USI.sv
        file_type: systemVerilogSource

    rtl:
        depend:
            - "socet:bus-components:bus_protocol_if:0.0.1"
        files:
            - source/usi_datapath.sv
            - source/split_fifo.sv
            - source/USI.sv
            - source/register_map.sv
            - source/asym_fifo.sv
            - source/shift_register.sv
            - source/uart.sv
            - source/control_unit.sv
        file_type: systemVerilogSource

    tb:
        files:
            - testbench/uart_peer.sv
            - testbench/usi_uart_tb.sv
        file_type: systemVerilogSource

    tb_register_map:
        files:
            - testbench/register_map_tb.sv
        file_type: systemVerilogSource

    tb_asym_fifo:
        files:
            - testbench/asym_fifo_tb.sv
        file_type: systemVerilogSource

    tb_shift_register:
        files:
            - testbench/shift_register_tb.sv
        file_type: systemVerilogSource

    tb_uart:
        files:
            - testbench/uart_peer.sv
            - testbench/usi_uart_tb.sv
        file_type: systemVerilogSource
    
    tb_split_fifo:
        files:
            - testbench/split_fifo_tb.sv
        file_type: systemVerilogSource

    lint_files:
        depend:
            - "socet:bus-components:bus_protocol_if:0.0.1"
        files:
            - source/usi_datapath.sv
            - source/USI.sv
            - source/register_map.sv
            - source/asym_fifo.sv
            - source/shift_register.sv
            - source/uart.sv
            - source/control_unit.sv
            - source/split_fifo.sv
        file_type: systemVerilogSource


targets:
    sim_I2C:
        description: Check I2C controller output signals
        default_tool: verilator
        filesets:
            - rtl_usi_datapath
            - rtl_I2C
            - tb_I2C
        toplevel: I2C_tb
        tools:
            verilator:
                verilator_options:
                    - --binary
                    - --timing
                    - --assert
                    - -Wno-TIMESCALEMOD
                    - --trace
                    - --trace-fst
                    - --trace-structs

    sim_usi_uart: &uart_integration
        description: UART register-map/datapath integration with a pin-level peer
        default_tool: verilator
        filesets:
            - tb_bus_interface_shim
            - rtl_usi_datapath
            - rtl_usi_uart
            - tb_uart
        toplevel: usi_uart_tb
        tools:
            verilator:
                verilator_options:
                    - --binary
                    - --timing
                    - --assert
                    - --no-sched-zero-delay
                    - -Wno-TIMESCALEMOD

    sim_usi_datapath:
        description: Simulate shared datapath with split FIFO
        default_tool: verilator
        filesets:
            - rtl_usi_datapath
            - tb_usi_datapath
        toplevel: usi_datapath_tb
        tools:
            verilator:
                verilator_options:
                    - --binary
                    - --timing
                    - --assert
                    - -Wno-TIMESCALEMOD

    default: &default
        filesets:
            - rtl
        toplevel: USI
    
    sim:
        <<: *default
        description: Simulate w/TB
        default_tool: verilator
        filesets_append:
            - "!tool_verilator? (tb)"
            - "tool_verilator? (tb)"
        toplevel: 
            - "tool_verilator? (usi_uart_tb)"
            - "!tool_verilator? (usi_uart_tb)"
        tools:
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps
            modelsim:
                vsim_options:
                    - -vopt
                    - -voptargs='+acc'
                    - -t ps
            vcs:
                vcs_options:
                    - -assert svaext
            verilator:
                verilator_options:
                    - --binary
                    - --timing
                    - --assert
                    - --no-sched-zero-delay
                    - -Wno-TIMESCALEMOD
                    - --trace
                    - --trace-fst
                    - --trace-structs
    
    sim_register_map:
        description: Simulate register map
        default_tool: verilator
        filesets:
            - rtl_register_map
            - tb_register_map
        toplevel: register_map_tb
        tools:
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps
            modelsim:
                vsim_options:
                    - -vopt
                    - -voptargs='+acc'
                    - -t ps
            vcs:
                vcs_options:
                    - -assert svaext
            verilator:
                verilator_options:
                    - --binary
                    - --trace
                    - --trace-fst
                    - --trace-structs

    sim_split_fifo:
        description: Simulate split FIFO
        default_tool: verilator
        filesets:
            - rtl_split_fifo
            - tb_split_fifo
        toplevel: split_fifo_tb
        tools:
            verilator:
                verilator_options:
                    - --binary
                    - --timing
                    - --trace
                    - --trace-fst
                    - --trace-structs

    sim_asym_fifo:
        <<: *default
        description: Simulate w/TB
        default_tool: verilator
        filesets_append:
            - "!tool_verilator? (tb_asym_fifo)"
            - "tool_verilator? (tb_asym_fifo)"
        toplevel: 
            - "tool_verilator? (asym_fifo_tb_top)"
            - "!tool_verilator? (asym_fifo_tb_top)"
        tools:
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps
            modelsim:
                vsim_options:
                    - -vopt
                    - -voptargs='+acc'
                    - -t ps
            vcs:
                vcs_options:
                    - -assert svaext
            verilator:
                verilator_options:
                    - --binary
                    - --trace
                    - --trace-fst
                    - --trace-structs

    sim_shift_register:
        <<: *default
        description: Simulate w/TB
        default_tool: verilator
        filesets_append:
            - "!tool_verilator? (tb_shift_register)"
            - "tool_verilator? (tb_shift_register)"
        toplevel: 
            - "tool_verilator? (shift_register_tb)"
            - "!tool_verilator? (shift_register_tb)"
        tools:
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps
            modelsim:
                vsim_options:
                    - -vopt
                    - -voptargs='+acc'
                    - -t ps
            vcs:
                vcs_options:
                    - -assert svaext
            verilator:
                verilator_options:
                    - --binary
                    - --trace
                    - --trace-fst
                    - --trace-structs

    sim_uart:
        <<: *uart_integration

    fpga:
        <<: *default
        description: Synthesize for FPGA
        default_tool: quartus
        toplevel:
            - USI
        parameters:
            - SYNTHESIS=true
        tools:
            quartus:
                family: Cyclone IV E
                device: EP4CE115F29C7 
                

    lint:
        filesets:
            - lint_files
        description: Linting
        default_tool: verilator
        toplevel: USI
        tools:
            verilator:
                verilator_options: ['--lint-only']
            veriblelint:
                verible_lint_args: ['--autofix=inplace-interactive', '--rules_config_search']

    format:
        filesets:
            - lint_files
        description: Formatting
        default_tool: veribleformat
        toplevel: USI_tb
        tools:
            veribleformat:
                verible_format_args: ['--indentation_spaces=4', '--inplace']

parameters:
    SYNTHESIS:
        datatype: bool
        paramtype: vlogdefine
