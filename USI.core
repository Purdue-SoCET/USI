CAPI=2:
name: socet:aft:USI:0.1.0

filesets:
    rtl:
        depend:
            - "socet:bus-components:bus_protocol_if:0.0.1"
            - "socet:digital-lib:counter:0.0.1"
        files:
            - source/USI.sv
            - source/register_map.sv
            - source/asym_fifo.sv
            - source/shift_register.sv
            - source/uart.sv
            - source/control_unit.sv
        file_type: systemVerilogSource

    tb:
        files:
            - testbench/USI_tb.sv
        file_type: systemVerilogSource

    tb_register_map:
        files:
            - testbench/register_map_tb.sv
        file_type: systemVerilogSource

    tb_asym_fifo:
        files:
            - testbench/asym_fifo_tb.sv
        file_type: systemVerilogSource

    tb_shift_register:
        files:
            - testbench/shift_register_tb.sv
        file_type: systemVerilogSource

    tb_uart:
        files:
            - testbench/uart_tb.sv
        file_type: systemVerilogSource

    lint_files:
        depend:
            - "socet:bus-components:bus_protocol_if:0.0.1"
            - "socet:digital-lib:counter:0.0.1"
        files:
            - source/USI.sv
            - source/register_map.sv
            - source/asym_fifo.sv
            - source/shift_register.sv
            - source/uart.sv
            - source/control_unit.sv
        file_type: systemVerilogSource


targets:
    default: &default
        filesets:
            - rtl
        toplevel: USI
    
    sim:
        <<: *default
        description: Simulate w/TB
        default_tool: verilator
        filesets_append:
            - "!tool_verilator? (tb)"
            - "tool_verilator? (tb)"
        toplevel: 
            - "tool_verilator? (USI_tb)"
            - "!tool_verilator? (USI_tb)"
        tools:
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps
            modelsim:
                vsim_options:
                    - -vopt
                    - -voptargs='+acc'
                    - -t ps
            vcs:
                vcs_options:
                    - -assert svaext
            verilator:
                verilator_options:
                    - --binary
                    - --trace
                    - --trace-fst
                    - --trace-structs
    
    sim_register_map:
        <<: *default
        description: Simulate w/TB
        default_tool: verilator
        filesets_append:
            - "!tool_verilator? (tb_register_map)"
            - "tool_verilator? (tb_register_map)"
        toplevel: 
            - "tool_verilator? (register_map_tb)"
            - "!tool_verilator? (register_map_tb)"
        tools:
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps
            modelsim:
                vsim_options:
                    - -vopt
                    - -voptargs='+acc'
                    - -t ps
            vcs:
                vcs_options:
                    - -assert svaext
            verilator:
                verilator_options:
                    - --binary
                    - --trace
                    - --trace-fst
                    - --trace-structs

    sim_asym_fifo:
        <<: *default
        description: Simulate w/TB
        default_tool: verilator
        filesets_append:
            - "!tool_verilator? (tb_asym_fifo)"
            - "tool_verilator? (tb_asym_fifo)"
        toplevel: 
            - "tool_verilator? (asym_fifo_tb_top)"
            - "!tool_verilator? (asym_fifo_tb_top)"
        tools:
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps
            modelsim:
                vsim_options:
                    - -vopt
                    - -voptargs='+acc'
                    - -t ps
            vcs:
                vcs_options:
                    - -assert svaext
            verilator:
                verilator_options:
                    - --binary
                    - --trace
                    - --trace-fst
                    - --trace-structs

    sim_shift_register:
        <<: *default
        description: Simulate w/TB
        default_tool: verilator
        filesets_append:
            - "!tool_verilator? (tb_shift_register)"
            - "tool_verilator? (tb_shift_register)"
        toplevel: 
            - "tool_verilator? (shift_register_tb)"
            - "!tool_verilator? (shift_register_tb)"
        tools:
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps
            modelsim:
                vsim_options:
                    - -vopt
                    - -voptargs='+acc'
                    - -t ps
            vcs:
                vcs_options:
                    - -assert svaext
            verilator:
                verilator_options:
                    - --binary
                    - --trace
                    - --trace-fst
                    - --trace-structs

    sim_uart:
        <<: *default
        description: Simulate w/TB
        default_tool: verilator
        filesets_append:
            - "!tool_verilator? (tb_uart)"
            - "tool_verilator? (tb_uart)"
        toplevel: 
            - "tool_verilator? (uart_tb_top)"
            - "!tool_verilator? (uart_tb_top)"
        tools:
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps
            modelsim:
                vsim_options:
                    - -vopt
                    - -voptargs='+acc'
                    - -t ps
            vcs:
                vcs_options:
                    - -assert svaext
            verilator:
                verilator_options:
                    - --binary
                    - --trace
                    - --trace-fst
                    - --trace-structs

    fpga:
        <<: *default
        description: Synthesize for FPGA
        default_tool: quartus
        toplevel:
            - USI
        parameters:
            - SYNTHESIS=true
        tools:
            quartus:
                family: Cyclone IV E
                device: EP4CE115F29C7 
                

    lint:
        filesets:
            - lint_files
        description: Linting
        default_tool: verilator
        toplevel: USI
        tools:
            verilator:
                verilator_options: ['--lint-only']
            veriblelint:
                verible_lint_args: ['--autofix=inplace-interactive', '--rules_config_search']

    format:
        filesets:
            - lint_files
        description: Formatting
        default_tool: veribleformat
        toplevel: USI_tb
        tools:
            veribleformat:
                verible_format_args: ['--indentation_spaces=4', '--inplace']

parameters:
    SYNTHESIS:
        datatype: bool
        paramtype: vlogdefine
